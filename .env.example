# Local development defaults to ./flowbudget.db if DATABASE_URL is omitted.
DATABASE_URL=sqlite:///./flowbudget.db
APP_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
ADMIN_INITIAL_USERNAME=Omar
ADMIN_INITIAL_EMAIL=omarsolanki46@gmail.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-initial-password

# Email verification. Keep SMTP_PASSWORD in environment secrets; never commit it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-sender@gmail.com
PUBLIC_APP_URL=https://budget-planner-ecru-seven.vercel.app
# SMTP_FROM must use the same domain as SMTP_USER. For best Outlook delivery,
# use a verified custom sending domain with SPF, DKIM, and DMARC records.
