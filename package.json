{
  "name": "flowbudget",
  "description": "Budgetly personal finance and shared spaces",
  "author": "Omar Solanki",
  "private": true,
  "version": "6.20.0",
  "androidVersionCode": 123,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "version:sync": "node scripts/version.mjs",
    "version:check": "node scripts/version.mjs --check",
    "deps:refresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-deps.ps1",
    "prebuild": "npm run version:check",
    "release:check": "npm run version:check && npm run lint && npm test && npm run build && npm run budget:client",
    "dev": "vite",
    "dev:api": "uvicorn api.app:app --reload --port 8000",
    "build": "vite build",
    "budget:client": "node scripts/check-client-budget.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run android:sync && npx cap run android",
    "android:build": "npm run android:sync && npx cap build android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:release-manifest": "node scripts/android-release-manifest.mjs",
    "preview": "vite preview",
    "desktop:installer": "npm run build && electron-builder --win nsis --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "date-fns": "^4.1.0",
    "driver.js": "^1.8.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "build": {
    "appId": "com.flowbudget.desktop",
    "productName": "Budgetly",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico",
      "artifactName": "Budgetly-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.22",
    "jsdom": "^27.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.12"
  }
}
